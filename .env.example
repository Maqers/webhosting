# PostHog analytics (client-side, read via import.meta.env — safe to expose)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# OpenAI (server-side only, used by api/generate-description.js and api/gift-assistant.js)
OPENAI_API_KEY=

# PostHog source map upload (build-time only, e.g. Vercel project env vars).
# POSTHOG_CLI_API_KEY is a personal API key: https://eu.posthog.com/settings/user-api-keys
# Leave unset to skip source map upload (build still succeeds).
POSTHOG_CLI_API_KEY=
POSTHOG_CLI_HOST=https://eu.posthog.com
